# Series Archive — 로컬 .env 예시 (실제 값은 채우고, 이 파일은 커밋 OK / .env 는 커밋 금지)

# ── 로그인 ──
# 방법1) .streamlit/secrets.toml 의 [auth.users] 사용(권장)
# 방법2) 아래 평면 변수
LOGIN_USERNAME=
LOGIN_PASSWORD=
# 또는 해시(sha256). 평문 대신 사용 가능
LOGIN_PASSWORD_HASH=

# ── 수집 옵션(렌더 시 수집 안 함, 버튼 클릭 시에만) ──
USE_APIFY=false
GOOGLE_TRANSPARENCY_PROVIDER=scraper   # scraper | apify
SOCIAL_VIDEO_PROVIDER=manual           # manual | apify

# ── API 키(전부 선택 — 없어도 앱은 동작) ──
YOUTUBE_API_KEY=
GEMINI_API_KEY=            # 영상 자막 없을 때 Gemini로 대본 추출(폴백)
GEMINI_MODEL=gemini-2.5-flash
APIFY_TOKEN=
META_ACCESS_TOKEN=
APIFY_GOOGLE_ACTOR=
